#include <stdio.h>

#define INF 9999
#define MAX 20

int main()
{
    int n;
    int cost[MAX][MAX];
    int dist[MAX], visited[MAX];
    int i, j, count, u, v;

    printf("Enter number of routers: ");
    scanf("%d", &n);

    printf("Enter cost matrix:\n");

    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
        {
            scanf("%d", &cost[i][j]);

            if (cost[i][j] == 0 && i != j)
                cost[i][j] = INF;
        }
    }

    for (i = 0; i < n; i++)
    {
        dist[i] = cost[0][i];
        visited[i] = 0;
    }

    dist[0] = 0;
    visited[0] = 1;

    for (count = 1; count < n; count++)
    {
        int min = INF;
        u = -1;

        for (i = 0; i < n; i++)
        {
            if (!visited[i] && dist[i] < min)
            {
                min = dist[i];
                u = i;
            }
        }

        if (u == -1)
            break;

        visited[u] = 1;

        for (v = 0; v < n; v++)
        {
            if (!visited[v] &&
                dist[u] + cost[u][v] < dist[v])
            {
                dist[v] =
                    dist[u] + cost[u][v];
            }
        }
    }

    printf("\nShortest paths from Router 1:\n");

    for (i = 0; i < n; i++)
    {
        printf("Router 1 -> Router %d = %d\n",
               i + 1,
               dist[i]);
    }

    return 0;
}
