#include <stdio.h>
#include <string.h>

struct ARP
{
    char ip[20];
    char mac[20];
};

int main()
{
    struct ARP table[] =
    {
        {"192.168.1.1", "AA:BB:CC:DD:EE:01"},
        {"192.168.1.2", "AA:BB:CC:DD:EE:02"},
        {"192.168.1.3", "AA:BB:CC:DD:EE:03"}
    };

    char ip[20];

    printf("Enter IP address: ");
    scanf("%s", ip);

    for (int i = 0; i < 3; i++)
    {
        if (strcmp(ip, table[i].ip) == 0)
        {
            printf("ARP Reply\n");
            printf("IP Address : %s\n", table[i].ip);
            printf("MAC Address: %s\n", table[i].mac);
            return 0;
        }
    }

    printf("ARP: Address not found.\n");

    return 0;
}
